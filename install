#!/usr/bin/env python3
"""Install or remove only this plugin; retain preferences and browser data."""
import argparse,json,os,pathlib,shutil,subprocess,tempfile,time
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--remove',action='store_true')
a=p.parse_args()
source=pathlib.Path(__file__).resolve().parent
config=pathlib.Path(os.environ.get('XDG_CONFIG_HOME',str(pathlib.Path.home()/'.config')))
plugins=config/'omarchy/plugins'
target=plugins/'jkarmel.zoom-controls'
def omarchy(*args):subprocess.run(['omarchy',*args],check=True)
if a.remove:
    if target.exists():
        if not (target/'.zoom-controls-install').is_file():raise SystemExit('Unrecognized installation; refusing to remove it.')
        omarchy('plugin','disable','jkarmel.zoom-controls')
        shutil.rmtree(target)
    print('Removed widget. Preferences and Zoom browser data retained.')
else:
    for tool in ['node','chromium','uwsm-app','hyprctl','ss','flock','wl-copy','wl-paste','systemd-run','omarchy']:
        if not shutil.which(tool):raise SystemExit('Missing dependency: '+tool)
    version=subprocess.check_output(['node','-p','process.versions.node'],text=True).strip()
    if int(version.split('.')[0])<22:raise SystemExit('Node.js 22 or newer is required.')
    plugins.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.zoom-controls-stage-',dir=plugins) as tmp:
        stage=pathlib.Path(tmp)/target.name
        stage.mkdir()
        for name in ['manifest.json','ZoomPanel.qml','MenuContent.qml','MenuModel.js','README.md','LICENSE','preview.png']:
            shutil.copy2(source/name,stage/name)
        for name in ['backend','bin','docs']:shutil.copytree(source/name,stage/name)
        (stage/'.zoom-controls-install').write_text('1\n')
        omarchy('plugin','validate',str(stage))
        backup=None
        if target.exists():
            backup=plugins/('.zoom-controls-backup-'+str(time.time_ns()))
            target.rename(backup)
        try:stage.rename(target)
        except BaseException:
            if backup:backup.rename(target)
            raise
    omarchy('plugin','enable','jkarmel.zoom-controls')
    print('Installed. If the bar retains old code, run: omarchy restart shell')
    if backup:print('Previous widget backup: '+str(backup))
