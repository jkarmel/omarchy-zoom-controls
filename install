#!/usr/bin/python3 -I
"""Install/remove Zoom Controls; preserve preferences and browser data."""
import importlib.util
from pathlib import Path

if __name__ == '__main__':
    spec = importlib.util.spec_from_file_location('zoom_installer', Path(__file__).resolve().parent / 'backend/installer.py')
    installer = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(installer)
    installer.main()
