#!/usr/bin/python3 -I
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'backend'))
from clipboard import main
try:
    sys.exit(main())
except Exception:
    # Do not print clipboard payloads or tool stderr.
    print('Could not copy the invite link.', file=sys.stderr)
    sys.exit(1)
